# GEMINI_API_KEY: Optional for AI portfolio features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000 in AI Studio)
PORT=3000

# MONGODB_URI: Connection string to MongoDB database (e.g. mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority)
# If left unset, the backend seamlessly uses an in-memory & file-persisted JSON database with the same Mongoose-compatible schema
MONGODB_URI=""

# NODE_ENV: 'development' or 'production'
NODE_ENV="development"

